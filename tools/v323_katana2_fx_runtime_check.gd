extends SceneTree
func _initialize() -> void:
    call_deferred("_run")
func _run() -> void:
    var game = load("res://scenes/main.tscn").instantiate()
    root.add_child(game)
    var trail = game.get("sword_trail")
    var effect = trail.get("effect_root")
    var plane = trail.get("source_plane")
    trail.begin_swing(0.0, true)
    assert(effect.basis.z.dot(plane.basis.z) < 0.0 and effect.basis.x.dot(plane.basis.x) < 0.0, "Katana2 arc must reverse both in-plane axes")
    assert(effect.basis.y.dot(plane.basis.y) > 0.0, "Katana2 must preserve its plate normal")
    trail.sample_swing(Vector3.ZERO, Vector3.ZERO, 0.20, 0.0)
    trail.advance(0.0, false)
    assert(not effect.visible, "No slash during windup")
    trail.sample_swing(Vector3.ZERO, Vector3.ZERO, 0.25, 0.0)
    trail.advance(0.0, false)
    assert(effect.visible, "Slash follows release")
    trail.sample_swing(Vector3.ZERO, Vector3.ZERO, 0.49, 0.0)
    trail.advance(0.0, false)
    assert(not effect.visible, "Slash ends after follow-through")
    trail.begin_swing()
    assert(effect.transform.is_equal_approx(plane.transform), "Next ordinary swing resets orientation")
    print("PASS Katana2 FX timing and orientation")
    game.queue_free()
    quit()
