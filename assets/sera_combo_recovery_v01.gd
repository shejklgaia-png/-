extends RefCounted
## v549: COMBO RECOVERY V01, reconstructed from approved HTML's exact
## stage endpoints, staggered easing, support-foot sequence and rigid leg IK.
## 120 Hz plus exact terminal sample; 19 local quaternions (int16),
## Waist local offset in 0.1 mm, including training-floor translation.
const CLIPS = ["ComboRecovery1","ComboRecovery2","ComboRecovery3"]
const DURATIONS = [0.36,0.4,0.48]
const COUNTS = [45,49,59]
const UUIDS = ["67435cb7-b6af-23e4-10f1-3cd13d8429fa","29fad052-d2b7-1a2a-eefa-30dd75fa7d0a","1b13d772-8cee-ef23-dc57-4da6bba6ce39","6c0141f8-17fe-6484-21e1-938ae81a620c","a4a11a19-29e6-e88c-b28d-3c9f2d4345ad","ba2331ff-9111-eaa6-2c11-eb1aa0756476","c2e134b6-eaf0-98ec-170a-3e483bf9898c","b8518144-9924-7969-c666-8ba52f98d49c","5e8dfb6e-99f0-c7d6-c0d3-87786424469d","4c3746de-484d-629d-68b8-1bba878b365c","3e2793de-8835-cb79-9c8b-8cc6688e94e6","30b7d34e-318f-ab2e-85f1-5dd04633b50e","d31ed778-8a2b-afd3-2dda-2e1d04afa3d4","fb7eeab3-e819-4476-d6fc-164e20235528","251412d1-08a8-f36c-d0bd-48cfa6355b1f","0c3eaba5-a458-69e8-82a2-953db329f62a","a5d943e1-db7a-1d7b-8273-9a46bf1ad981","72fc68ce-31d7-e90a-b974-f839e892ed02","5ca5a292-ba81-ea2a-ff06-f12b60e9c3bb"]
const FRAME_BYTES: int = 158
const DATA: String = ""

static func install(rig: Node3D) -> void:
    var bank: PackedByteArray = Marshalls.base64_to_raw(DATA)
    var total: int = 0
    for count in COUNTS:
        total += int(count)
    if bank.size() != total * FRAME_BYTES:
        return
    var bones: Dictionary = rig.get("bones")
    var animations: Dictionary = rig.get("animations")
    for uid in UUIDS:
        if not bones.has(uid):
            return
    var first: int = 0
    for i in range(CLIPS.size()):
        var duration: float = float(DURATIONS[i])
        var count: int = int(COUNTS[i])
        var tracks: Dictionary = {}
        for j in range(UUIDS.size()):
            var rotations: Array = []
            var positions: Array = []
            for n in range(count):
                var t: float = minf(float(n) / 120.0, duration)
                var offset: int = (first + n) * FRAME_BYTES + j * 8
                var q := Quaternion(float(bank.decode_s16(offset)),
                    float(bank.decode_s16(offset + 2)), float(bank.decode_s16(offset + 4)),
                    float(bank.decode_s16(offset + 6))).normalized()
                rotations.append({"time": t, "quaternion": q})
                if j == 0:
                    var root: int = (first + n) * FRAME_BYTES + 152
                    # Existing rig position tracks are in Blockbench units.
                    var p := Vector3(bank.decode_s16(root), bank.decode_s16(root + 2),
                        bank.decode_s16(root + 4)) * (0.0001 / 0.065)
                    positions.append({"time": t, "value": p})
            tracks[UUIDS[j]] = {"rotation": rotations, "position": positions, "scale": []}
        animations[CLIPS[i]] = {"length": duration, "looped": false,
            "last_key_time": duration, "tracks": tracks}
        first += count
