[gd_scene load_steps=2 format=3]

[ext_resource type="PackedScene" path="res://scenes/bittaran_battle_world.tscn" id="1_world"]

; One ready-to-present image per frame, with the live 3D model, visible
; mesh-ID contours, debug HUD and transparent effects already composited.
; Replacing the canonical scene (rather than rerouting only the NEXUS menu)
; means all Bittaran entries use the same completed-frame presentation.
[node name="BittaranBattle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; SubViewportContainer forwards touch/mouse/gamepad input to its child
; SubViewport, preserving the original SERA gesture and lock-screen handlers.
[node name="CompletedFrameContainer" type="SubViewportContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
stretch = true
stretch_shrink = 1

; ID geometry and the visible battle are both children of this SAME
; presentation target. ID target renders before the world shader samples it.
; Only this completed output texture is shown on the root window.
[node name="CompletedBattleFrame" type="SubViewport" parent="CompletedFrameContainer"]
size = Vector2i(720, 1280)
own_world_3d = true
transparent_bg = false
render_target_update_mode = 4
audio_listener_enable_2d = true
audio_listener_enable_3d = true

[node name="BittaranBattleWorld" parent="CompletedFrameContainer/CompletedBattleFrame" instance=ExtResource("1_world")]
