[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/command_nexus.gd" id="1_world"]
[ext_resource type="Script" path="res://scripts/nexus_canonical_placement.gd" id="2_place"]
[ext_resource type="Script" path="res://scripts/nexus_camera_angle_placement.gd" id="3_angle"]

[node name="CommandNexus" type="Node3D"]
script = ExtResource("1_world")

; These nodes MUST exist before CommandNexus._ready() starts. The HUD's
; working buttons are created early, while runtime editor .new() calls at the
; end of _ready() were repeatedly skipped/returned null on Android.
; Keep model and camera editors independent; no extra viewport or 3D geometry.
[node name="NexusPlacementOverlay" type="CanvasLayer" parent="."]
layer = 8

[node name="NexusCanonicalPlacement" type="Control" parent="NexusPlacementOverlay"]
mouse_filter = 2
script = ExtResource("2_place")

[node name="NexusCameraAnglePlacement" type="Control" parent="NexusPlacementOverlay"]
mouse_filter = 2
script = ExtResource("3_angle")
