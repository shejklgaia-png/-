# Godot generates this cache locally on Android/desktop.
.godot/
# Editor temporary and swap files
*.swp
*.tmp
*.bak
# Python execution artifacts
__pycache__/
*.pyc

# Completed sync-probe artifacts; do not recommit these to the working tree.
SERA_AUTOSYNC_TEST.txt
SERA_SAFE_SYNC_TEST.txt
SYNC_PROBE_*.txt
# Android/Blockbench may leave these 'trashed' duplicates during uploads.
models/storage/.trashed-*
# Tracked *.import files are NOT cache clutter: retain UID remaps.

# Android APK build outputs and private signing material.
build/apk/
dist/
*.keystore

# Makinas is licensed for embedding in games but may not be redistributed
# as a standalone font in SERA's PUBLIC GitHub source repository.
# Install these originals locally from the author's official download.
assets/fonts/Makinas4Flat.otf
assets/fonts/Makinas4Square.otf
assets/fonts/Makinas4Flat.otf.import
assets/fonts/Makinas4Square.otf.import
# OFL Chakra Petch is fetched by the same local preparation script.
assets/fonts/ChakraPetch-Medium.ttf
assets/fonts/ChakraPetch-SemiBold.ttf
assets/fonts/ChakraPetch-Medium.ttf.import
assets/fonts/ChakraPetch-SemiBold.ttf.import

# Local developer placement previews (synced by dedicated script)
.sera-placement/
