            # at its rotor; blue cabinet gaps are independent emissive slots.
            _directed_searchlight("RotorServiceSearchlight",
                Vector3(-1.10, 3.19, -0.22),
                Vector3(-0.27, 1.43, 1.19),
                Vector3(0.42, 0.20, 0.34), Color("#a9e7ff"),
