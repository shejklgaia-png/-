    vec3 orange = mix(vec3(1.0, 0.19, 0.035),
        vec3(1.0, 0.61, 0.22), clamp(shaped * 1.4, 0.0, 1.0));
    ALBEDO = orange;
    EMISSION = orange * 3.2 * shaped;
    ALPHA = shaped * 0.58;
}
