                _round_floor_pool("WarehouseRoundFloorGlow",
                    Vector3(side * 0.70, 0.33, 1.74),
                    Vector2(1.35, 1.35), Color("#ffdfac"), 0.32)
        "SCRAP_COLLECTOR":
            # Separate tracking/recognition and collected-bin functions.
