func _add_furnace_flipbook() -> void:
    if _furnace_flame_atlas == null:
        var encoded: String = FURNACE_FLAME_PNG_BASE64.replace("\n", "").strip_edges()
        var image := Image.new()
        var error: Error = image.load_png_from_buffer(Marshalls.base64_to_raw(encoded))
        if error != OK or image.get_width() != 512 or image.get_height() != 480:
            push_warning("Smelter flame atlas invalid; skipping flame instead of drawing white.")
            return
        image.convert(Image.FORMAT_RGBA8)
        _furnace_flame_atlas = ImageTexture.create_from_image(image)
    if _furnace_flame_atlas == null:
        return
    var sprite := Sprite3D.new()
    sprite.name = "SmelterVisibleCombustionFlame"
    sprite.set_meta("FX_NO_OUTLINE", true)
    sprite.texture = _furnace_flame_atlas
    sprite.hframes = 8
    sprite.vframes = 6
    sprite.frame = 0
    sprite.pixel_size = 0.01
    sprite.position = Vector3(0.0, 1.475, 1.185)
    sprite.scale = Vector3(1.25 / 0.64, 0.95 / 0.80, 1.0)
    sprite.shaded = false
    sprite.transparent = true
    sprite.double_sided = true
    sprite.no_depth_test = false
    sprite.render_priority = RENDER_ORDER.FACILITY_VFX_FOREGROUND
    sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    sprite.modulate = Color(0.94, 0.86, 0.72, 1.0)
    add_child(sprite)
    _furnace_sprite = sprite


func _add_fire_floor() -> void:
    # Light-pool illusion, not a real screen-space SSR/reflection: this works
    # on mobile GL Compatibility without depth-copy or refraction passes.
    # This plane must clear the foundation top, not clip into the slab.
    _make_surface("SmelterFireFloorReflection",
        Vector3(0.0, 0.30, 2.20), Vector2(3.0, 3.40),
        Vector3(-PI * 0.5, 0.0, 0.0),
        FIRE_FLOOR_SHADER)

func sample_fire(seconds: float) -> void:
    if is_instance_valid(_furnace_sprite):
        var frame: int = posmod(int(floor(seconds * 24.0)), 48)
        if _furnace_sprite.frame != frame:
            _furnace_sprite.frame = frame
    if _furnace_lamp != null:
        var pulse: float = 0.83 + 0.09 * sin(seconds * 2.7) + (
            0.05 * sin(seconds * 4.83)) + 0.03 * sin(seconds * 8.17)
        _furnace_lamp.light_energy = 2.05 * pulse

func _process(delta: float) -> void:
    _elapsed += maxf(delta, 0.0)
    sample_fire(_elapsed)
