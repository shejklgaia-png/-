    fade.add_point(0.24, Color(0.83, 0.88, 0.91, 0.25))
    fade.add_point(0.42, Color(0.83, 0.88, 0.91, 0.0))
    fade.set_color(fade.get_point_count() - 1, Color(0.83, 0.88, 0.91, 0.0))
    var origins: Array[Vector3] = [Vector3(-0.93, 5.47, -1.57),
