    vec2 p = UV;
    float longfade = 1.0 - smoothstep(0.27, 1.0, p.y);
    float crossfade = pow(max(0.0, 1.0 - abs(p.x - 0.5) * 2.0), 1.25);
    float tongues = 0.76 + 0.12 * sin(TIME * 2.7 + p.x * 8.0)
