"""
static func texture() -> ImageTexture:
    if _atlas != null:
        return _atlas
    var decoded := Image.new()
    var error: Error = decoded.load_png_from_buffer(Marshalls.base64_to_raw(PNG.replace("\n","").strip_edges()))
    if error != OK or decoded.get_width() != COLUMNS*FRAME_WIDTH or decoded.get_height() != ROWS*FRAME_HEIGHT:
        push_warning("Baked furnace atlas invalid; omit flame rather than show white.")
        return null
    decoded.convert(Image.FORMAT_RGBA8)
    _atlas = ImageTexture.create_from_image(decoded)
    return _atlas

static func make_sheet(label: String, span: Vector2, at: Vector3, opacity: float, offset: int) -> Sprite3D:
    var atlas := texture()
    if atlas == null:
        return null
    var sprite := Sprite3D.new()
    sprite.name = label
    sprite.texture = atlas
    sprite.hframes = COLUMNS
    sprite.vframes = ROWS
    sprite.pixel_size = 0.01
    sprite.scale = Vector3(span.x/(FRAME_WIDTH*0.01),span.y/(FRAME_HEIGHT*0.01),1.0)
    sprite.position = at
    sprite.frame = posmod(offset,FRAMES)
    sprite.set_meta("flame_phase_offset",offset)
    sprite.set_meta("FX_NO_OUTLINE",true)
    sprite.set_meta("sera_no_view_edges",true)
    sprite.set_meta("sera_preserve_authored_material",true)
    sprite.shaded = false
    sprite.transparent = true
    sprite.double_sided = true
    sprite.no_depth_test = false
    sprite.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    sprite.modulate = Color(1.0,1.0,1.0,opacity)
    return sprite

static func sample(sheet: Sprite3D, seconds: float) -> void:
    if not is_instance_valid(sheet):
        return
    var next: int = posmod(int(floor(seconds*FPS))+int(sheet.get_meta("flame_phase_offset",0)),FRAMES)
    if sheet.frame != next:
        sheet.frame = next

static func radiance(seconds: float, offset: int = 0) -> float:
    var phase: float = fposmod(seconds*FPS+float(offset),float(FRAMES))
    var index: int = int(floor(phase))
    return lerpf(float(FRAME_RADIANCE[index]),float(FRAME_RADIANCE[(index+1)%FRAMES]),phase-float(index))
