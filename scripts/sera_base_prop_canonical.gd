static func site_layouts() -> Dictionary:
    var layouts: Dictionary = {}
    for key in SITE_ROWS:
        var parts: Array[Dictionary] = []
        for row in SITE_ROWS[key]:
            parts.append({"kind": row[0], "at": Vector2(row[1], row[2]),
                "scale": row[3], "yaw_deg": row[4], "stack": row[5],
                "pattern": row[6], "accent": row[7], "satellite": row[8]})
        layouts[key] = parts
    return layouts


static func scrap_layout() -> Array[Dictionary]:
    var parts: Array[Dictionary] = []
    for index in range(SCRAP_ROWS.size()):
        var row: Array = SCRAP_ROWS[index]
        parts.append({"index": index, "x": row[0], "z": row[1],
            "yaw_deg": row[2], "scale": row[3], "profile": row[4],
            "stack": row[5], "pattern": row[6]})
    return parts
