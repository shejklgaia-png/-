; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SERA v545"
run/main_scene="res://scenes/base_exploration.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
quit_on_go_back=false

[autoload]

SeraSave="*res://scripts/sera_save.gd"
SeraPlacementSync="*res://scripts/sera_placement_sync.gd"
SeraRuntimePerf="*res://scripts/sera_runtime_perf.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
; Expand to tall/wide Android aspect ratios instead of letterboxing the 9:16
; design viewport. 3D outlines continue to use their rendering viewport px.
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/window/width_override=450
window/size/window/height_override=800

[filesystem]

import/blender/enabled=false

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
